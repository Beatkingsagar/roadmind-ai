# RoadMind AI — Environment Configuration Example

# Server Environment (development | testing | production)
ROADMIND_ENV=development

# Database URL (defaults to local SQLite database in backend/roadmind.db)
DATABASE_URL=sqlite:///./backend/roadmind.db

# Storage Directories
EVIDENCE_STORAGE_PATH=./backend/storage/evidence

# Deterministic Seed Configuration
FIXTURE_RANDOM_SEED=42
GRAPH_VERSION=v1.0.0
DATA_MODE=synthetic

# Operator Authorization (for reviewing incidents and admin demo reset)
ROADMIND_OPERATOR_TOKEN=replace_with_a_secure_random_token

# External Routing Provider (OSRM)
OSRM_ROUTING_URL=https://router.project-osrm.org

# Optional External Live Traffic Providers (Phase 4)
# TRAFFIC_PROVIDER=auto
# TOMTOM_API_KEY=your_tomtom_api_key_here
# HERE_API_KEY=your_here_api_key_here

# Optional Verified Toll Data Providers (Phase 5)
# TOLL_PROVIDER=auto
# TOLLGURU_API_KEY=your_tollguru_api_key_here
# TOLLGURU_API_URL=https://apis.tollguru.com/v2/calc-polyline

