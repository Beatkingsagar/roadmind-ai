# RoadMind AI Web Client — Environment Configuration Example

# Backend REST API Base URL (defaults to http://localhost:8000/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: CARTO Basemaps API Key (https://carto.com/basemaps/key)
# When omitted or empty, RoadMind AI automatically defaults to public OpenStreetMap Standard tiles,
# which require NO API key for local development and display crisply in both light and dark themes.
# VITE_CARTO_API_KEY=your_carto_api_key_here
